[tools]
python = "{{ python_version }}"
uv = "0.13"

[settings]
# Auto-activate the uv-managed .venv when entering the project.
python.uv_venv_auto = true

[tasks.setup]
description = "Install dependencies and git hooks"
run = ["uv sync", "uv run pre-commit install"]

[tasks.lint]
description = "Lint with ruff"
run = "uv run ruff check ."

[tasks.format]
description = "Format with ruff"
run = ["uv run ruff check --fix .", "uv run ruff format ."]

[tasks.typecheck]
description = "Type check with ty"
run = "uv run ty check"

[tasks.test]
description = "Run the test suite"
run = "uv run pytest"

[tasks.check]
description = "Run all pre-commit hooks and tests"
run = ["uv run pre-commit run --all-files", "uv run pytest"]
