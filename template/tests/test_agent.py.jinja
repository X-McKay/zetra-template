import pytest

from {{ package_name }} import Agent, PermissionDeniedError, Policy


def test_default_policy_denies_everything() -> None:
    agent = Agent("test")
    with pytest.raises(PermissionDeniedError):
        agent.authorize("read:config")


def test_allowed_action_is_authorized() -> None:
    agent = Agent("test", Policy(allowed_actions=frozenset({"read:config"})))
    agent.authorize("read:config")


def test_unlisted_action_is_denied() -> None:
    agent = Agent("test", Policy(allowed_actions=frozenset({"read:config"})))
    with pytest.raises(PermissionDeniedError, match="write:config"):
        agent.authorize("write:config")
